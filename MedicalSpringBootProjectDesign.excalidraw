      "updated": 1782744868362,
      "link": null,
      "locked": false,
      "text": "@RestController\nRequestMapping(\"/reception\")\n\npublic class ReceptionController{\n\n          private final DoctorService doctorService;\n    private final ReceptionService receptionService;\n\n    \n    //Constructor\n    public ReceptionController(DoctorService doctorService,\n                                ReceptionService receptionService) {  \n}\n        \n    \n@PostMapping(\"/getdoctor\")\n     public DoctorEntity getDoctor(@RequestBody PatientEntity patient)\n",
      "fontSize": 21.05924565270465,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@RestController\nRequestMapping(\"/reception\")\n\npublic class ReceptionController{\n\n          private final DoctorService doctorService;\n    private final ReceptionService receptionService;\n\n    \n    //Constructor\n    public ReceptionController(DoctorService doctorService,\n                                ReceptionService receptionService) {  \n}\n        \n    \n@PostMapping(\"/getdoctor\")\n     public DoctorEntity getDoctor(@RequestBody PatientEntity patient)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
