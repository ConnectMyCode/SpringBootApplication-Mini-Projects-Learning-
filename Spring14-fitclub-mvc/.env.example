# ================= LOCAL / DEV ENVIRONMENT TEMPLATE =================
# A TEMPLATE, not a real secrets file - only placeholders, no real
# passwords. Copy it to a REAL ".env" file, which docker-compose reads
# AUTOMATICALLY if it's in the same folder as docker-compose.yml:
#   cp .env.example .env
# ".env" is in .gitignore and should NEVER be committed. This
# ".env.example" file IS meant to be committed.

# ----- Database -----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=fitclub_db
DB_USERNAME=root
DB_PASSWORD=change-me-locally

# ----- App -----
SERVER_PORT=8080

# ----- React frontend origin (used by WebConfig's CORS setup) -----
FRONTEND_ORIGIN=http://localhost:3000
